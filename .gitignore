# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
.vscode/
.worktrees/
.claude/worktrees/
*.swp
*.swo

# Node
node_modules/

# Skill 优化/eval 运行时 scratch（skill-creator 生成）
*-workspace/

# outside-voice 调试留档不入库（评审四源命中: 全量 diff/潜在敏感内容防经 checkpoint add -A 永久入历史）[impl-review-fix]
**/.outside-voice/

# Python 运行期产物（防 checkpoint-commit.sh 的 git add -A 把测试/运行生成的字节码缓存
# 裹进手写 commit——batch-triage 大扫除批一项一 commit 协议同根因风险）[impl-review-fix]
__pycache__/
*.pyc
.pytest_cache/
# 真实 CLI 集成测试产物；Claude 从已信任的项目根目录启动，产物按轮隔离。
/.test/
/openspec/issues/.recorder.lock

# FF-0 守卫的一次性 ack 哨兵（人 touch、hook 读到即删）——本地令牌，不该入库
/openspec/.ff0-ack

# sdflow-upstream-watch facts 中间产物（collect 写、advance 读，一轮一份，非留存状态）
/openspec/upstream/.facts/

# 双轴审 diff 快照：可由 git 再生的瞬态产物，不入库（防 checkpoint add -A 带入并随 archive 永久留存）
**/impl-reports/*review-package*.diff
