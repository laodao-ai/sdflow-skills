+        return real_run(cmd, **kwargs)
+
+    monkeypatch.setattr(rec_mod.subprocess, "run", short_timeout)
+
+    with pytest.raises(ValueError) as exc:
+        repo_root(str(repo))
+
+    assert "超时" in str(exc.value)
+    assert repo_root.__name__ == "repo_root"
