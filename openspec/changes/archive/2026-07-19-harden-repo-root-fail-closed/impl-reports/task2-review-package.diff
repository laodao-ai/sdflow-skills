+def _init_repo(path):
+    path.mkdir(parents=True, exist_ok=True)
+    _git("init", "-q", cwd=path)
+    _git("config", "user.email", "t@example.com", cwd=path)
+    _git("config", "user.name", "t", cwd=path)
+    return path
+
+
+def _commit_empty(path):
+    _git("commit", "-q", "--allow-empty", "-m", "init", cwd=path)
+
