+# 仓库/工作树发现类变量——测试前一律清空，确保用例断言的是 repo_root 自身的判据，
+# 而不是宿主环境残留（CI 的 git hook 场景会真的导出它们）。
+GIT_DISCOVERY_ENV = (
+    "GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_CEILING_DIRECTORIES",
+    "GIT_INDEX_FILE", "GIT_DISCOVERY_ACROSS_FILESYSTEM",
