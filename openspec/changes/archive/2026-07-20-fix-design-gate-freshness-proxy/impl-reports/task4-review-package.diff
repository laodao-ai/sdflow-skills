+    返回 run_gate 的 (code, js, human)。同帧另带一份源码，贴 `git add -A` 的真实形态。
+    """
+    d, _ = _seed_tasks(repo, b"### Task 1: A\n- [ ] s\n")
+    _reanchor(repo, d)
+    mutate(d)
+    (repo / "src.py").write_text("# impl\n", encoding="utf-8")
+    commit_all(repo, subject)
+    return run_gate(repo)
+
