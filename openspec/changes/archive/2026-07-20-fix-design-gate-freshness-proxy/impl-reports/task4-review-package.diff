+    t = js["stale_trigger"]
+    assert t["category"] == "mixed-paths"
+    assert t["subject"] == subject
+    assert t["sha"] == _head(repo)[:7]
+    assert "design.md" in t["paths"] and "tasks.md" not in t["paths"]
