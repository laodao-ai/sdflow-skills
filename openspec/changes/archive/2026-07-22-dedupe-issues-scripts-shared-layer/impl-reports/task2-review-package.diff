+def _todo_minimal_block(tid, cells, status, hist):
+    title = cells[2]
+    return (f"\n---\n\n## {tid}: {title}\n\n"
+            f"| 属性 | 值 |\n|------|------|\n"
+            f"| 模块 | {cells[1]} |\n| 类型 | {cells[3]} |\n| 状态 | {status} |\n\n{hist}")
