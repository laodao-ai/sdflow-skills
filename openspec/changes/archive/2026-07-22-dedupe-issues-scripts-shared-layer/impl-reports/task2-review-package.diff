-        marker = re.match(r"^(```+|~~~+)", stripped)
-        if marker:
-            token = marker.group(1)[0]
-            if fence is None:
-                fence = token
-            elif token == fence:
-                fence = None
-            continue
-        if fence is not None or not re.match(r"^##\s+状态总览(?:\s|（|$)", line):
