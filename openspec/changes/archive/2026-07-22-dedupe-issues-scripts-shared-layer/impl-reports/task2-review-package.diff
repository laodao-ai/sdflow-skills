+
+def _has_rootcause(lines, start, end):
+    for i in range(start, end):
+        m = re.match(r"\*\*根因\*\*：(.*)", lines[i].strip())
+        if m:
+            val = m.group(1).strip()
+            return bool(val) and not re.fullmatch(r"<.*>", val)
+    return False
+
