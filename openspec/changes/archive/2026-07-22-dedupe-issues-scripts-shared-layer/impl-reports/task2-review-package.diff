-def _write_all(fd, data):
-    view = memoryview(data)
-    offset = 0
-    while offset < len(view):
-        written = os.write(fd, view[offset:])
-        if written <= 0:
-            raise OSError("recorder lock metadata write made no progress")
-        offset += written
