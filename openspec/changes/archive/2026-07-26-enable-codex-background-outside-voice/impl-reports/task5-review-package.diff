+    def test_interrupted_install_leaves_no_consistent_snapshot(self, tmp_path):
+        """安装中断 ⇒ MUST NOT 留下一份「自洽但陈旧」的 manifest。
+
+        制造真实中断：把已安装的 shell helper 置为只读 ⇒ 下一次 `cp` 失败 ⇒ `set -e` 当场
