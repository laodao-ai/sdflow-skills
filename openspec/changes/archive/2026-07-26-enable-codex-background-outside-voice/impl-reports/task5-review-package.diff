+class TestCapabilitySnapshot:
+    def test_installs_job_helper_with_exec_bit_and_python3_interpreter(self, tmp_path):
+        """job helper 是 `claude --bg --exec` 之外的**另一个执行面**：装漏 = 整条后台通道死。"""
