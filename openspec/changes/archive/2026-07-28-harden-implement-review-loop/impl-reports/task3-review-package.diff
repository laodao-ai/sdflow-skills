+def test_inflight_plan_rename_resets_completion_window(repo):
+    """🔴 违反「MUST NOT 重命名在途 plan」——`plan_first_sha` 用 `git log --diff-filter=A`
+    取窗口起点，该判据不跟随重命名：改名后新路径的「首次新增」就是那次改名 commit，
+    改名前的 checkpoint(task1-…) 落在窗口外。
+
+    锁定该已知行为（design Migration Plan 明文接受，非 resolver 缺陷——resolver 只负责
+    在两个名字里定位当前落盘的那个，不做重命名跟踪/历史修复）：resolver 正确 pickup 到
+    改名后的新文件（不 fail-closed 到 UNKNOWN），但改名前已完成的 task1 不再计入
+    done_tasks——「task1 已完成」这一事实被 gate 拒绝承认，必须重新走一遍 checkpoint
+    才能被数到（该场景不可判定其真实完成状态，故本用例断言其被排除，而非被漏数放行）。
+    """
+    d = approved_change(repo, plan=PLAN2)   # 旧名落盘，Task1/Task2
+    commit_all(repo, "checkpoint(task1-a): 改名前完成 task1")
+    # 违反纪律：在途 plan 被重命名（旧名 → 新名）
+    old_rel = str((d / "superpowers-plan.md").relative_to(repo))
+    new_rel = str((d / "tickets.md").relative_to(repo))
+    subprocess.run(["git", "-C", str(repo), "mv", old_rel, new_rel],
+                    check=True, capture_output=True, text=True)
+    commit_all(repo, "checkpoint(task2-b)之前的改名提交：违规重命名在途 plan")
+    code, js, _ = run_gate(repo)
+    # resolver 正确找到改名后的 tickets.md（未 fail-closed 判 UNKNOWN——只有一个候选存在）
+    assert js["verdict"] == "CONTINUE_IMPL"
+    # 但窗口起点被推到改名 commit：改名前的 task1 checkpoint 落窗口外，未被计入
+    assert "1" not in js["done_tasks"]
