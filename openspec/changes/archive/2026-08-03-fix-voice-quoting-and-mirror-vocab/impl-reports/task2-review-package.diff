+    r = _fc(host="codex", subagents="unavailable", mirrors="domain,history") + "\n"
+    assert _has(al.check_fanout_consistency(r), "dead-fanout-multi-mirror")
+
 def test_fanout_unavailable_single_mirror_ok():               # unavailable + 1 镜 → 放行
