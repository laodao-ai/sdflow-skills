 def lines(p: Path):
     return p.read_text(encoding="utf-8").splitlines()
 
 
 def has_line(p: Path, *needles: str) -> bool:
     """存在**同一行**同时含全部 needles。跨行结构一律不算命中。"""
     return any(all(n in ln for n in needles) for ln in lines(p))
 
 
