+
+    if not ID_RE.match(issue_id):
+        _die(f"ID 格式非法：{issue_id!r}（须匹配 [A-Z][1-9][0-9]*）")
+
+    path, location = find_issue(root, issue_id)
+    if path is None:
+        _die(f"未找到 ID：{issue_id}")
+
+    if location == "open":
+        _die(f"ID {issue_id} 不在终态（位于 open/），无需 reopen")
+
