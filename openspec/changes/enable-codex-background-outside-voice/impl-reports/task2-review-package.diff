+        _seed_site(run_dir, rc_kind="rc0_nonempty", now=time.time(), write_job=False,
+                   write_started=False)
+
+    worker = threading.Thread(target=publish_later)
+    worker.start()
+    env = _env(fake_claude, {"FAKE_CLAUDE_AGENTS_MODE": "fixed",
+                             "FAKE_CLAUDE_FIXED": _fixed_roster()})
