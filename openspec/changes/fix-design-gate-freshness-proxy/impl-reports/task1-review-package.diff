+def _write_tasks(repo, data, name="tasks.md"):
+    """原始字节写入 change 目录下的文件（不经文本层，保真测试用）。"""
+    p = repo / "openspec" / "changes" / "demo" / name
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_bytes(data)
+    return p
