-        # runner≠host 且双方均真机队 → 唯一合法「第二意见」须 reason_code='ok'
-        return "cross-model" if reason_code == "ok" else "illegal"
-    return "illegal"                                    # catch-all（显式 else，防 if/elif 漏 else 放行 runner='unknown' 等）
