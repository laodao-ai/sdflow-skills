-            or (host in _DUOS and reason_code in _NOEXEC_KNOWN_CODES)
-        ):
-            return "no-exec"
-        return "illegal"
-    if host in _DUOS and runner in _DUOS:
-        if runner == host:
-            # 同族行：唯一分野是 reason_code 是否属降级码集；否则即自审假绿（F6）
