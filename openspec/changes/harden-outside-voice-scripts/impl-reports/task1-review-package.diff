   render-prompt|exec)
     ctx=""; tmo=300
     while [ $# -gt 0 ]; do
       case "$1" in
         --context-file)
           [ $# -ge 2 ] || usage
           ctx="$2"; shift 2 ;;
         --timeout)
           [ $# -ge 2 ] || usage
           case "$2" in ''|*[!0-9]*) usage ;; esac
+          # `10#` 强制十进制解析，正确捕获 0/00/000 等所有前导零变体（承重约束 C1：
+          # --timeout 0 必须与既有非法值同样 exit 2，不得放行到 do_exec 才在别处报错）。
+          [ "$((10#$2))" -eq 0 ] && usage
           tmo="$2"; shift 2 ;;
         *) usage ;;
       esac
     done
     [ -n "$ctx" ] || usage
     if [ "$cmd" = "render-prompt" ]; then
       render_prompt "$ctx"
     else
       do_exec "$ctx" "$tmo"
     fi
