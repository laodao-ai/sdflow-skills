++        "GIT_INDEX_FILE", "GIT_DISCOVERY_ACROSS_FILESYSTEM",
++        "GIT_CONFIG_COUNT", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM",
++    )
++    discovery_env_prefixes = ("GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_")
