+def _tok_line(session, step, ts, inp, out, cr, cc, anchor=True, reason="ok"):
+    obj = {"v": 1, "ts": ts, "step": step, "session": session, "host": "claude",
+           "anchor": anchor, "reason": reason}
+    if anchor:
+        obj["usage"] = {"input": inp, "output": out, "cache_read": cr,
