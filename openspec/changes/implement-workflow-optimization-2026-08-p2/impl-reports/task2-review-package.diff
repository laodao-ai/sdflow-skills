+class DispositionError(Exception):
+    """mirror-dispositions.yaml 结构性坏（非 yq 可解析 / 非列表 / 条目缺字段 /
+    disposition 越域 / 降采样缺 condition）—— fail-loud，DD1「宁红勿静默」（adr/0016）。"""
