 def _stage_col(wt, stage):
     """[impl-review-fix F12] per-change 表阶段 Δ 列格式化——0 或缺失均显 "—"，
     非 0 时四舍五入 1 位小数，与其余 "—" 空箱口径一致（同 hr-tg/无度量锚同理）。"""
