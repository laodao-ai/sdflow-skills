+def _v1_marker_block_bodies(lines):
+    """成对 marker（`<!-- sdflow-issue-block:start/end id=X -->`）之间的原文，去掉 marker
+    标签本身（design.md 字段映射表：「marker block 内容 → body 原样搬入（去掉 marker 标签）」）。"""
+    bodies = {}
+    active = None
+    start_idx = None
+    for idx, line in enumerate(lines):
