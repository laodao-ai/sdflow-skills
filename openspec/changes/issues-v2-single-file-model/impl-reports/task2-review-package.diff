+        if not m:
+            continue
+        kind, item_id = m.group(1), m.group(2)
+        if kind == "start":
+            active, start_idx = item_id, idx
+        elif kind == "end" and active == item_id:
+            bodies[item_id] = "".join(lines[start_idx + 1:idx])
+            active, start_idx = None, None
+    return bodies
+
