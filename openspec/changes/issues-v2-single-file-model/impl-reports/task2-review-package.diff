+def _v1_heading_block_bodies(lines):
+    """`## {ID}: ...` 标题块（含标题行本身）到下一个 `---` 或下一个标题为止的原文
+    （legacy-owned item 的 detail section，MIG-01 Scenario 1）。"""
+    starts = []
+    for i, line in enumerate(lines):
+        m = _V1_HEADING_RE.match(line)
+        if m:
