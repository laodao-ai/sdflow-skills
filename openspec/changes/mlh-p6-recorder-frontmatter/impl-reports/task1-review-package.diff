+def parse_recorder_document(raw, expected_pool):
+    if not isinstance(raw, bytes):
+        _frontmatter_error("document 输入非法", "必须是 bytes")
+    bom, envelope, body, eol = _split_envelope(raw)
+    span = _find_recorder_span(envelope, eol)
