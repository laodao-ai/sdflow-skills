+            items[item_id] = _json_object_no_duplicates(match.group(2), item_id)
+    else:
+        _frontmatter_error("recorder items 非法", "必须是 items: 或 items: {}")
+    return _validated_recorder_model({"schema": 1, "pool": pool, "mode": mode, "items": items})
