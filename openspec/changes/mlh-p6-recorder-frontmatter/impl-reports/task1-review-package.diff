+def split_sections(lines):
+    """返回 (head_end_idx, table_rows_range, body_start_idx)。
+    head_end = 状态总览表分隔行后的位置；表行在 [rows_start, rows_end)。"""
+    sections = _legacy_table_sections(lines)
+    return sections[0] if sections else None
