+        result = {"format": model["mode"], "model": model, "raw": raw, "body": body,
+                  "eol": eol, "bom": bom, "namespace_span": (start, end)}
+    lines = body.decode("utf-8").splitlines(keepends=True)
+    section = split_sections(lines)
