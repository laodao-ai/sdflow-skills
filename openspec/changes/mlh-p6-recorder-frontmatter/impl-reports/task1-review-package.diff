--- a/sdflow-issues/scripts/issues.py
+++ b/sdflow-issues/scripts/issues.py
@@ -64,6 +64,252 @@ SKILLS_ROOT = os.path.dirname(os.path.dirname(SCRIPT_DIR))
 BUGLIST_SCRIPT = os.path.join(SKILLS_ROOT, "sdflow-buglist", "scripts", "buglist.py")
